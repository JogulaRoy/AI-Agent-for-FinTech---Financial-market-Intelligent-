# ============================================================
# ENVIRONMENT TEMPLATE
# Copy to .env and fill in real values. Do NOT commit .env.
# ============================================================

# --- Financial data providers ---
EODHD_API_KEY=
FMP_API_KEY=
TWELVE_DATA_API_KEY=

# Optional legacy news key (fallback only).
ALPHA_VANTAGE_API_KEY=

# --- LLM (provider-agnostic reasoning layer) ---
# Supported LLM_PROVIDER values: gemini
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# --- Behaviour toggles ---
ENABLE_YFINANCE_FALLBACK=true
CACHE_TTL_SECONDS=900
RISK_FREE_RATE=0.0
